# Copy to .env and edit. Everything has a safe mock default, so the project
# runs with an empty .env. Fill these in only when you go "real".

# Providers: "mock" (offline, default) or "openai"
RAG_LLM_PROVIDER=mock
RAG_EMBEDDING_PROVIDER=mock
RAG_RERANKER_PROVIDER=mock          # or "cross_encoder"

RAG_OPENAI_API_KEY=
RAG_LLM_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=256

# Vector store: ":memory:" (default) or "http://localhost:6333"
RAG_QDRANT_URL=:memory:

# Pipeline knobs
RAG_CHUNK_SIZE=600
RAG_TOP_K_VECTOR=12
RAG_TOP_K_RERANK=4

# Experiment tracking (optional): e.g. http://localhost:5000
RAG_MLFLOW_TRACKING_URI=
